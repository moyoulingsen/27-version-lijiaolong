Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Navigation1
      Splitter Ratio: 0.58
    Tree Height: 680
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 32; 35; 38
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Meter Grid
      Enabled: true
      Alpha: 0.25
      Cell Size: 1
      Color: 130; 135; 140
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: map
    - Class: rviz_default_plugins/Map
      Name: Arena Map
      Enabled: true
      Alpha: 0.72
      Color Scheme: map
      Draw Behind: true
      Topic:
        Value: /map
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
        Depth: 1
      Update Topic:
        Value: /map_updates
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
        Depth: 5
    - Class: rviz_default_plugins/RobotModel
      Name: Sentry Robot
      Enabled: true
      Alpha: 1
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
        Depth: 5
      Visual Enabled: true
      Collision Enabled: false
      Update Interval: 0
    - Class: rviz_default_plugins/LaserScan
      Name: Gazebo Lidar
      Enabled: true
      Topic:
        Value: /scan
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        History Policy: Keep Last
        Depth: 5
      Style: Points
      Size (Pixels): 3
      Size (m): 0.02
      Color Transformer: FlatColor
      Color: 255; 220; 40
      Decay Time: 0.1
      Use Fixed Frame: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.45
      Show Arrows: true
      Show Axes: true
      Show Names: false
    - Class: rviz_common/Group
      Name: Navigation
      Enabled: true
      Displays:
        - Class: rviz_default_plugins/Map
          Name: Global Costmap
          Enabled: true
          Alpha: 0.28
          Color Scheme: costmap
          Draw Behind: false
          Topic:
            Value: /global_costmap/costmap
            Durability Policy: Transient Local
            Reliability Policy: Reliable
            History Policy: Keep Last
            Depth: 1
          Update Topic:
            Value: /global_costmap/costmap_updates
            Durability Policy: Volatile
            Reliability Policy: Reliable
            History Policy: Keep Last
            Depth: 5
        - Class: rviz_default_plugins/Map
          Name: Local Costmap
          Enabled: true
          Alpha: 0.25
          Color Scheme: costmap
          Draw Behind: false
          Topic:
            Value: /local_costmap/costmap
            Durability Policy: Transient Local
            Reliability Policy: Reliable
            History Policy: Keep Last
            Depth: 1
          Update Topic:
            Value: /local_costmap/costmap_updates
            Durability Policy: Volatile
            Reliability Policy: Reliable
            History Policy: Keep Last
            Depth: 5
        - Class: rviz_default_plugins/Path
          Name: Nav2 Global Plan
          Enabled: true
          Topic:
            Value: /plan
            Durability Policy: Volatile
            Reliability Policy: Reliable
            History Policy: Keep Last
            Depth: 5
          Line Style: Lines
          Line Width: 0.06
          Color: 20; 230; 255
          Buffer Length: 1
          Pose Style: None
        - Class: rviz_default_plugins/Path
          Name: DWB Local Plan
          Enabled: true
          Topic:
            Value: /local_plan
            Durability Policy: Volatile
            Reliability Policy: Reliable
            History Policy: Keep Last
            Depth: 5
          Line Style: Lines
          Line Width: 0.04
          Color: 255; 80; 30
          Buffer Length: 1
          Pose Style: None
    - Class: rviz_default_plugins/MarkerArray
      Name: Scenario Status
      Enabled: true
      Topic:
        Value: /simulation/markers
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
        Depth: 1
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
        Depth: 5
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Arena Top View
      Angle: 0
      Scale: 30
      X: 14
      Y: 7.5
      Value: TopDownOrtho (rviz)
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1500
  X: 60
  Y: 40
  Hide Left Dock: false
  Hide Right Dock: false
