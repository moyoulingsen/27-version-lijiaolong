<?xml version="1.0"?>
<!--
  前五个任务的上层综合树。

  下面引入的五个文件只定义各自的标准子树，可以在 Groot2 中独立查看；
  本文件只负责系统层面的组合和优先级调度。
  ReactiveFallback 在这里作为优先级选择器使用：当前最先满足条件的任务
  获得控制权，优先级更低且正在运行的任务会被中止。
-->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <include path="01_return_home.xml"/>
  <include path="02_posture_switch.xml"/>
  <include path="03_attack_outpost.xml"/>
  <include path="04_no_ammo.xml"/>
  <include path="05_dodge.xml"/>

  <BehaviorTree ID="MainTree">
    <ReactiveFallback name="FiveTaskPriority">
      <!-- 最高优先级：比赛退出阶段 2 后，存活的哨兵返回启动点。 -->
      <SubTree ID="ReturnHome"
               home_x="4.971" home_y="7.5" home_z="1.0"
               home_yaw="0.0" frame_id="map" tolerance="0.15"/>

      <!-- 开局任务：在裁判数据确认敌方 6 号前哨站被摧毁前，
           机器人由打前哨任务持续控制。 -->
      <SubTree ID="AttackOutpost"
               attack_x="16.0" attack_y="11.0" attack_z="1.0"
               attack_yaw="0.0" frame_id="map" tolerance="0.20"
               posture_cooldown_sec="5.0" target="6"
               applied_posture="{applied_posture}"/>

      <!-- 比赛进行阶段内，无弹量行为优先于普通姿态行为，
           可以在站桩点等待或切换到补给点领取待领弹量。 -->
      <SubTree ID="NoAmmoBehavior"
               supply_x="2.0" supply_y="1.0"
               standby_x="4.971" standby_y="7.5" goal_z="1.0"
               goal_yaw="0.0" frame_id="map" tolerance="0.15"
               posture_cooldown_sec="5.0"
               pending_ammo="{pending_ammo}"
               applied_posture="{applied_posture}"/>

      <!-- 哨兵已经到达原目标并且受到不可见伤害时，
           躲避行为临时接管导航。 -->
      <SubTree ID="DodgeBehavior"
               quiet_period_sec="2.0" step="0.8" tolerance="0.15"
               min_x="0.2" max_x="27.8" min_y="0.2" max_y="14.8"
               frame_id="map" posture_cooldown_sec="5.0"
               applied_posture="{applied_posture}"/>

      <!-- 比赛进行阶段内的最低优先级行为：应用请求的或默认的姿态。
           比赛不在阶段 2 时该子树主动失败，使上层树能够反映未激活状态，
           而不是使用无条件成功伪造任务完成。 -->
      <SubTree ID="PostureManager"
               requested_posture="3" cooldown_sec="5.0"
               applied_posture="{applied_posture}"/>
    </ReactiveFallback>
  </BehaviorTree>
</root>
