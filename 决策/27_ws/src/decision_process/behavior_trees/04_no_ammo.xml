<?xml version="1.0"?>
<root BTCPP_format="4">
  <BehaviorTree ID="NoAmmoBehavior">
    <ReactiveSequence name="NoAmmoSequence">
      <GameRunning/>
      <OutOfAmmo/>
      <SetCombatIdle/>
      <ApplyPosture requested_posture="3"
                    cooldown_sec="{posture_cooldown_sec}"
                    applied_posture="{applied_posture}"/>
      <ReactiveFallback name="CollectOrStandby">
        <ReactiveSequence name="CollectPendingAmmoSequence">
          <PendingAmmoAvailable pending_ammo="{pending_ammo}"/>
          <CollectPendingAmmo x="{supply_x}" y="{supply_y}" z="{goal_z}"
                              yaw="{goal_yaw}" frame_id="{frame_id}"
                              tolerance="{tolerance}"/>
        </ReactiveSequence>
        <NavigateToPose x="{standby_x}" y="{standby_y}" z="{goal_z}"
                        yaw="{goal_yaw}" frame_id="{frame_id}"
                        tolerance="{tolerance}"/>
      </ReactiveFallback>
    </ReactiveSequence>
  </BehaviorTree>

  <TreeNodesModel>
    <SubTree ID="NoAmmoBehavior">
      <input_port name="supply_x" default="2.0">补给点x坐标</input_port>
      <input_port name="supply_y" default="1.0">补给点y坐标</input_port>
      <input_port name="standby_x" default="4.971">站桩点x坐标</input_port>
      <input_port name="standby_y" default="7.5">站桩点y坐标</input_port>
      <input_port name="goal_z" default="1.0">导航目标z坐标</input_port>
      <input_port name="goal_yaw" default="0.0">目标朝向</input_port>
      <input_port name="frame_id" default="map">导航参考坐标系</input_port>
      <input_port name="tolerance" default="0.15">到达判定容差</input_port>
      <input_port name="posture_cooldown_sec" default="5.0">姿态切换冷却</input_port>
      <output_port name="pending_ammo" default="{pending_ammo}">内部估算待领弹量</output_port>
      <output_port name="applied_posture" default="{applied_posture}">实际姿态</output_port>
    </SubTree>
    <Condition ID="GameRunning" editable="true"/>
    <Condition ID="OutOfAmmo" editable="true"/>
    <Condition ID="PendingAmmoAvailable" editable="true">
      <output_port name="pending_ammo">当前估算待领弹量</output_port>
    </Condition>
    <Action ID="SetCombatIdle" editable="true"/>
    <Action ID="ApplyPosture" editable="true">
      <input_port name="requested_posture" default="3">无弹时使用移动姿态</input_port>
      <input_port name="cooldown_sec" default="5.0">姿态切换冷却秒数</input_port>
      <output_port name="applied_posture">实际应用姿态</output_port>
    </Action>
    <Action ID="CollectPendingAmmo" editable="true">
      <input_port name="x" default="2.0">补给点x坐标</input_port>
      <input_port name="y" default="1.0">补给点y坐标</input_port>
      <input_port name="z" default="1.0">导航目标z坐标</input_port>
      <input_port name="yaw" default="0.0">目标朝向</input_port>
      <input_port name="frame_id" default="map">导航参考坐标系</input_port>
      <input_port name="tolerance" default="0.15">补给点到达容差</input_port>
    </Action>
    <Action ID="NavigateToPose" editable="true">
      <input_port name="x">目标地图x坐标</input_port>
      <input_port name="y">目标地图y坐标</input_port>
      <input_port name="z" default="1.0">导航目标z坐标</input_port>
      <input_port name="yaw" default="0.0">目标朝向角</input_port>
      <input_port name="frame_id" default="map">目标参考坐标系</input_port>
      <input_port name="tolerance" default="0.15">平面到达容差</input_port>
    </Action>
  </TreeNodesModel>
</root>
