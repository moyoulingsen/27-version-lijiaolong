<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mid360_robot">

  <xacro:arg name="camera_topic" default="/camera/image_raw"/>
  <xacro:arg name="camera_info_topic" default="/camera/camera_info"/>
  <xacro:arg name="mid360_topic" default="/mid360_points"/>

  <xacro:include filename="$(find bot_description)/urdf/base.urdf.xacro"/>
  <xacro:include filename="$(find bot_description)/urdf/camera.xacro"/>
  <xacro:include filename="$(find bot_description)/urdf/mid360_mount.xacro"/>

  <xacro:base/>

  <xacro:camera
    name="front_camera"
    parent="base_link"
    image_topic="$(arg camera_topic)"
    info_topic="$(arg camera_info_topic)"
    update_rate="10.0">
    <origin xyz="0.30 0 0.32" rpy="0 0 0"/>
  </xacro:camera>

  <xacro:mid360
    name="mid360"
    parent="base_link"
    topic="$(arg mid360_topic)"
    update_rate="10.0">
    <origin xyz="0 0 0.30" rpy="0 0 0"/>
  </xacro:mid360>

  <!-- A simple planar controller makes cmd_vel/odom available in Gazebo. -->
  <gazebo>
    <plugin name="planar_move_controller" filename="libgazebo_ros_planar_move.so">
      <command_topic>cmd_vel</command_topic>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <update_rate>20.0</update_rate>
    </plugin>
  </gazebo>
</robot>
