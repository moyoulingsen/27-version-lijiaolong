<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="base">

  <!-- Dimensions are deliberately kept in one place so the model is easy to tune. -->
  <xacro:property name="body_length" value="0.80"/>
  <xacro:property name="body_width" value="0.60"/>
  <xacro:property name="body_height" value="0.24"/>
  <xacro:property name="body_mass" value="8.0"/>

  <xacro:macro name="box_inertia" params="mass x y z">
    <inertial>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass * (y*y + z*z) / 12.0}"
        ixy="0.0"
        ixz="0.0"
        iyy="${mass * (x*x + z*z) / 12.0}"
        iyz="0.0"
        izz="${mass * (x*x + y*y) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="base">
    <!-- Ground-projected frame used by navigation and the planar Gazebo controller. -->
    <link name="base_footprint"/>

    <link name="base_link">
      <xacro:box_inertia
        mass="${body_mass}"
        x="${body_length}"
        y="${body_width}"
        z="${body_height}"/>

      <visual name="base_visual">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find bot_description)/meshes/base_link.STL"/>
        </geometry>
        <material name="body_blue">
          <color rgba="0.18 0.35 0.75 1.0"/>
        </material>
      </visual>

      <!-- A simple box collision keeps Gazebo stable even if the visual mesh is complex. -->
      <collision name="base_collision">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${body_length} ${body_width} ${body_height}"/>
        </geometry>
      </collision>
    </link>

    <joint name="base_footprint_to_base_link" type="fixed">
      <parent link="base_footprint"/>
      <child link="base_link"/>
      <origin xyz="0 0 ${body_height / 2.0}" rpy="0 0 0"/>
    </joint>

    <gazebo reference="base_link">
      <material>Gazebo/Blue</material>
      <mu1>0.8</mu1>
      <mu2>0.8</mu2>
      <kp>20000.0</kp>
      <kd>10.0</kd>
      <minDepth>0.001</minDepth>
      <maxVel>100.0</maxVel>
    </gazebo>
  </xacro:macro>
</robot>
