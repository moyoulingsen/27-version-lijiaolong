<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="mid360_demo">
    <gravity>0 0 -9.81</gravity>
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Dynamic objects intentionally start above the ground: moving them in the
         Gazebo GUI demonstrates gravity and prevents collision interpenetration. -->
    <model name="drop_box">
      <pose>1.4 0.6 0.8 0 0 0</pose>
      <link name="link">
        <inertial><mass>2.0</mass><inertia><ixx>0.167</ixx><iyy>0.167</iyy><izz>0.167</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.45 0.45 0.45</size></box></geometry><surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>0.45 0.45 0.45</size></box></geometry><material><ambient>0.8 0.2 0.1 1</ambient><diffuse>0.8 0.2 0.1 1</diffuse></material></visual>
      </link>
    </model>
    <model name="drop_cylinder">
      <pose>2.0 -0.8 1.0 0 0 0</pose>
      <link name="link">
        <inertial><mass>3.0</mass><inertia><ixx>0.575</ixx><iyy>0.575</iyy><izz>0.375</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><cylinder><radius>0.3</radius><length>0.9</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.3</radius><length>0.9</length></cylinder></geometry><material><ambient>0.15 0.35 0.8 1</ambient><diffuse>0.15 0.35 0.8 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
