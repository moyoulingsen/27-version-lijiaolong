<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bot_description</name>
  <version>0.1.0</version>
  <description>Simple mobile robot description with a camera and a Livox MID360 simulator.</description>

  <maintainer email="maintainer@example.com">robotics team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_plugins</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- Provides libros2_livox.so, used by mid360_mount.xacro at run time. -->
  <exec_depend>ros2_livox_simulation</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
