<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="camera">

  <xacro:property name="camera_width" value="0.08"/>
  <xacro:property name="camera_height" value="0.05"/>
  <xacro:property name="camera_depth" value="0.08"/>
  <xacro:property name="camera_mass" value="0.10"/>

  <xacro:macro name="camera_inertia" params="mass x y z">
    <inertial>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass * (y*y + z*z) / 12.0}"
        ixy="0.0"
        ixz="0.0"
        iyy="${mass * (x*x + z*z) / 12.0}"
        iyz="0.0"
        izz="${mass * (x*x + y*y) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <!--
    A complete camera module: links, optical frame, fixed joints, and Gazebo sensor.
    The optical frame follows the ROS convention (x forward, y left, z up).
  -->
  <xacro:macro
    name="camera"
    params="name parent:=base_link image_topic:=/camera/image_raw info_topic:=/camera/camera_info update_rate:=10.0 *origin">

    <link name="${name}_link">
      <xacro:camera_inertia
        mass="${camera_mass}"
        x="${camera_width}"
        y="${camera_depth}"
        z="${camera_height}"/>
      <visual name="${name}_visual">
        <geometry>
          <box size="${camera_width} ${camera_depth} ${camera_height}"/>
        </geometry>
        <material name="camera_black">
          <color rgba="0.03 0.03 0.03 1.0"/>
        </material>
      </visual>
      <collision name="${name}_collision">
        <geometry>
          <box size="${camera_width} ${camera_depth} ${camera_height}"/>
        </geometry>
      </collision>
    </link>

    <link name="${name}_optical_link"/>

    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}_link"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <joint name="${name}_optical_joint" type="fixed">
      <parent link="${name}_link"/>
      <child link="${name}_optical_link"/>
      <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
    </joint>

    <gazebo reference="${name}_link">
      <sensor type="camera" name="${name}_sensor">
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>${update_rate}</update_rate>
        <camera name="${name}">
          <horizontal_fov>1.5009831567</horizontal_fov>
          <image>
            <width>800</width>
            <height>600</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>100.0</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
        <plugin name="${name}_gazebo_ros_camera" filename="libgazebo_ros_camera.so">
          <camera_name>${name}</camera_name>
          <frame_name>${name}_optical_link</frame_name>
          <image_topic_name>${image_topic}</image_topic_name>
          <camera_info_topic_name>${info_topic}</camera_info_topic_name>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
