<?xml version="1.0"?>
<root BTCPP_format="4">
  <BehaviorTree ID="AttackOutpost">
    <ReactiveSequence name="AttackOutpostSequence">
      <GameRunning/>
      <EnemyOutpostAlive/>
      <ApplyPosture requested_posture="1"
                    cooldown_sec="{posture_cooldown_sec}"
                    applied_posture="{applied_posture}"/>
      <NavigateToPose x="{attack_x}" y="{attack_y}" z="{attack_z}"
                      yaw="{attack_yaw}" frame_id="{frame_id}"
                      tolerance="{tolerance}"/>
      <EngageOutpost target="{target}"/>
    </ReactiveSequence>
  </BehaviorTree>

  <TreeNodesModel>
    <SubTree ID="AttackOutpost">
      <input_port name="attack_x" default="16.0">模拟击打点x坐标</input_port>
      <input_port name="attack_y" default="11.0">模拟击打点y坐标</input_port>
      <input_port name="attack_z" default="1.0">导航目标z坐标</input_port>
      <input_port name="attack_yaw" default="0.0">到点目标朝向</input_port>
      <input_port name="frame_id" default="map">导航参考坐标系</input_port>
      <input_port name="tolerance" default="0.20">到达判定容差</input_port>
      <input_port name="posture_cooldown_sec" default="5.0">姿态切换冷却时间</input_port>
      <input_port name="target" default="6">敌方前哨目标编号</input_port>
      <output_port name="applied_posture" default="{applied_posture}">实际姿态</output_port>
    </SubTree>
    <Condition ID="GameRunning" editable="true"/>
    <Condition ID="EnemyOutpostAlive" editable="true"/>
    <Condition ID="EnemyOutpostDestroyed" editable="true"/>
    <Action ID="ApplyPosture" editable="true">
      <input_port name="requested_posture" default="3">1进攻、2防御、3移动</input_port>
      <input_port name="cooldown_sec" default="5.0">姿态切换冷却秒数</input_port>
      <output_port name="applied_posture">实际应用的姿态</output_port>
    </Action>
    <Action ID="NavigateToPose" editable="true">
      <input_port name="x">目标地图x坐标</input_port>
      <input_port name="y">目标地图y坐标</input_port>
      <input_port name="z" default="1.0">目标z坐标</input_port>
      <input_port name="yaw" default="0.0">目标朝向角</input_port>
      <input_port name="frame_id" default="map">目标参考坐标系</input_port>
      <input_port name="tolerance" default="0.15">平面到达容差</input_port>
    </Action>
    <Action ID="EngageOutpost" editable="true">
      <input_port name="target" default="6">敌方前哨目标编号</input_port>
    </Action>
  </TreeNodesModel>
</root>
