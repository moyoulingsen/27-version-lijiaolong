<?xml version="1.0"?>
<root BTCPP_format="4">
  <BehaviorTree ID="PatrolBehavior">
    <ReactiveSequence name="PatrolSequence">
      <GameRunning/>
      <SentryAlive/>
      <SetCombatIdle/>
      <ApplyPosture requested_posture="3" cooldown_sec="{posture_cooldown_sec}"
                    applied_posture="{applied_posture}"/>
      <PatrolRoute points="{points}" z="{goal_z}" yaw="{goal_yaw}"
                   frame_id="{frame_id}" tolerance="{tolerance}"
                   min_x="{min_x}" max_x="{max_x}"
                   min_y="{min_y}" max_y="{max_y}"/>
    </ReactiveSequence>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="PatrolBehavior">
      <input_port name="points" default="5.0,5.0;9.0,5.0;9.0,9.0">分号分隔的任意数量巡逻点</input_port>
      <input_port name="goal_z" default="1.0">导航目标z坐标</input_port>
      <input_port name="goal_yaw" default="0.0">巡逻目标朝向</input_port>
      <input_port name="frame_id" default="map">导航参考坐标系</input_port>
      <input_port name="tolerance" default="0.15">到达判定容差</input_port>
      <input_port name="min_x" default="0.0">场地最小x</input_port>
      <input_port name="max_x" default="28.0">场地最大x</input_port>
      <input_port name="min_y" default="0.0">场地最小y</input_port>
      <input_port name="max_y" default="15.0">场地最大y</input_port>
      <input_port name="posture_cooldown_sec" default="5.0">姿态切换冷却</input_port>
      <output_port name="applied_posture" default="{applied_posture}">实际姿态</output_port>
    </SubTree>
    <Condition ID="GameRunning" editable="true"/>
    <Condition ID="SentryAlive" editable="true"/>
    <Action ID="SetCombatIdle" editable="true"/>
    <Action ID="ApplyPosture" editable="true">
      <input_port name="requested_posture" default="3">1进攻、2防御、3移动</input_port>
      <input_port name="cooldown_sec" default="5.0">姿态切换冷却秒数</input_port>
      <output_port name="applied_posture">实际应用的姿态</output_port>
    </Action>
    <Action ID="PatrolRoute" editable="true">
      <input_port name="points">格式为 x,y;x,y，可修改数量</input_port>
      <input_port name="z" default="1.0">导航目标z坐标</input_port>
      <input_port name="yaw" default="0.0">目标朝向</input_port>
      <input_port name="frame_id" default="map">导航参考坐标系</input_port>
      <input_port name="tolerance" default="0.15">平面到达容差</input_port>
      <input_port name="min_x" default="0.0">场地最小x</input_port>
      <input_port name="max_x" default="28.0">场地最大x</input_port>
      <input_port name="min_y" default="0.0">场地最小y</input_port>
      <input_port name="max_y" default="15.0">场地最大y</input_port>
    </Action>
  </TreeNodesModel>
</root>
