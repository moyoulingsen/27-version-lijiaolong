<?xml version="1.0"?>
<root BTCPP_format="4">
  <include path="common_position.xml"/>
  <include path="mechanism_policy.xml"/>

  <!-- Conservative route on the friendly half of the arena. -->
  <BehaviorTree ID="ConservativePatrol">
    <ReactiveSequence name="ConservativePatrolSequence">
      <SubTree ID="MechanismPolicy"
               posture="2"
               gyro_mode="3"
               gimbal_enabled="true"
               gimbal_rotate="true"
               posture_command="{posture_command}"
               gyro_mode_command="{gyro_mode_command}"
               gimbal_enabled_command="{gimbal_enabled}"
               gimbal_rotate_command="{gimbal_rotate}"/>

      <KeepRunningUntilFailure name="ConservativePatrolLoop">
        <Sequence name="ConservativePatrolPoint">
          <SelectPatrolPoint
            points="{conservative_patrol_points}"
            index="{waypoint_index}"
            target_x="{target_x}"
            target_y="{target_y}"
            point_count="{point_count}"/>

          <ReactiveFallback name="GoToConservativePoint">
            <SubTree ID="PositionCheck"
                     current_x="{current_x}"
                     current_y="{current_y}"
                     target_x="{target_x}"
                     target_y="{target_y}"
                     tolerance="{tolerance}"
                     localization_valid="{localization_valid}"/>
            <SendGoalPose target_x="{target_x}"
                          target_y="{target_y}"
                          target_z="1.0"
                          target_yaw="0.0"
                          frame_id="map"
                          goal_x="{goal_x}"
                          goal_y="{goal_y}"
                          goal_z="{goal_z}"
                          goal_yaw="{goal_yaw}"
                          goal_frame_id="{goal_frame_id}"
                          goal_enabled="{goal_enabled}"/>
          </ReactiveFallback>

          <DisableGoal goal_enabled="{goal_enabled}"/>
          <AdvancePatrolPoint index="{waypoint_index}"
                              point_count="{point_count}"
                              next_index="{waypoint_index}"/>
        </Sequence>
      </KeepRunningUntilFailure>
    </ReactiveSequence>
  </BehaviorTree>
</root>
